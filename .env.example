# Copy to .env and fill in. Never commit .env.
# Only secrets live here. Wallets, events, and Discord channels live in config/*.yaml.

# --- Process ---
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080
# Public HTTPS origin Paystack and Shopify can reach. No trailing slash.
# Example: https://pinme.yourdomain.com  or a Cloudflare tunnel URL.
PUBLIC_BASE_URL=https://REPLACE_ME.example.com
STATE_DIR=data

# --- Discord ---
# Developer Portal → your app → Bot → Reset Token.
# https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
# Optional. Set this while building so slash commands update instantly.
# Right-click your server icon → Copy Server ID (Developer Mode on).
DISCORD_GUILD_ID=

# --- Paystack ---
# Dashboard → Developers. Test keys start with sk_test_ / pk_test_.
# https://dashboard.paystack.com/v2/developers
PAYSTACK_SECRET_KEY=
# Optional. Not used to verify webhooks. Kept so a frontend checkout can share this env file.
PAYSTACK_PUBLIC_KEY=
# Webhook signing secret (whsec_...). Developers → API configuration.
# Required for the new Paystack-Signature header. Leave blank to only accept
# the legacy x-paystack-signature header, which is signed with PAYSTACK_SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=
# Set true only if the bot is NOT behind a proxy that rewrites the client IP.
PAYSTACK_ENFORCE_IP=false
PAYSTACK_BASE_URL=https://api.paystack.co

# --- Shopify ---
# Custom app: Admin → Settings → Apps and sales channels → Develop apps.
# SHOPIFY_WEBHOOK_SECRET is the app Client secret (API secret key),
# OR the signing secret shown when you create a webhook under
# Settings → Notifications → Webhooks. Use whichever path you subscribed with.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-10

# --- Wallets: EVM ---
# One RPC URL per chain you enable in config/wallets.yaml.
# Alchemy, Infura, QuickNode, Ankr, or your own node. Free tiers are enough
# for a handful of wallets polled once a minute.
ETH_RPC_URL=
# Sepolia testnet. Alchemy URL shape: https://eth-sepolia.g.alchemy.com/v2/<key>
SEPOLIA_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=
BSC_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
CELO_RPC_URL=
# Optional. Enables transfer-level alerts (not just balance changes) on EVM.
# Create one at https://etherscan.io/apis — the v2 key works across Etherscan-family chains.
ETHERSCAN_API_KEY=

# --- Wallets: TRON ---
# https://www.trongrid.io/  (free key). Header sent as TRON-PRO-API-KEY.
TRONGRID_API_KEY=
TRONGRID_BASE_URL=https://api.trongrid.io

# --- Wallets: optional push providers (leave blank to keep polling) ---
# Alchemy Notify → Address Activity → signing key.
ALCHEMY_WEBHOOK_SIGNING_KEY=
# Moralis Streams secret (not the API key). Settings in the Streams dashboard.
MORALIS_STREAMS_SECRET=
